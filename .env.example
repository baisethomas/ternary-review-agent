# GitHub App (never expose these with NEXT_PUBLIC_)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=

# Review model
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
MAX_DIFF_CHARS=160000
# Optional per-million token rates used for Analytics cost estimates.
# Set these to the contracted/current rates for OPENAI_MODEL; estimates are not billing records.
OPENAI_INPUT_COST_PER_MILLION=
OPENAI_OUTPUT_COST_PER_MILLION=

# Vercel Sandbox authenticates automatically with VERCEL_OIDC_TOKEN in deployments.
# These are only needed when running against Vercel Sandbox outside Vercel.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Protects POST /api/reviews/run and signs dashboard sessions.
INTERNAL_API_TOKEN=

# Durable queue delivery. TERNARY_BASE_URL should be the public deployment origin.
QSTASH_TOKEN=
TERNARY_BASE_URL=https://YOUR_DOMAIN

# Protects the durable queue recovery worker invoked by Vercel Cron.
CRON_SECRET=

# Durable per-repository Watch/Pause settings (Vercel Marketplace → Upstash Redis)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Durable Review Event Ledger (Vercel Marketplace → Neon Postgres)
DATABASE_URL=
# Immutable review history is retained for 365 days by default.
REVIEW_EVENT_RETENTION_DAYS=365
