# GitHub App (never expose these with NEXT_PUBLIC_)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=

# Review model
OPENROUTER_API_KEY=
# Default for repositories without an explicit organization/repository policy.
# Scout / default: DeepSeek Flash (supports strict json_schema + require_parameters).
OPENROUTER_MODEL=~deepseek/deepseek-v4-flash-latest
MAX_DIFF_CHARS=160000
# TER-25: route prep / model selection / sandbox build policy.
REVIEW_ROUTE_MODE=risk
REVIEW_ROUTE_SHADOW=
REVIEW_ROUTE_SCOUT_MODEL=~deepseek/deepseek-v4-flash-latest
REVIEW_ROUTE_DEEP_MODEL=moonshotai/kimi-k2.6
# If the routed model fails, retry Flash (skipped when Flash was already primary), then Terra.
REVIEW_ROUTE_FALLBACK_MODEL=~deepseek/deepseek-v4-flash-latest
REVIEW_ROUTE_CATCHALL_MODEL=openai/gpt-5.6-terra
# Skip sandbox build by default; Vercel CI already builds PRs. Set to 1 to also run build in sandbox.
REVIEW_ROUTE_FULL_SANDBOX=
# Legacy alias: set to 0/false to force full sandbox checks including build.
REVIEW_ROUTE_SLIM_SANDBOX=
REVIEW_ROUTE_LARGE_DIFF_LINES=400
REVIEW_ROUTE_LARGE_DIFF_FILES=40

# Vercel Sandbox authenticates automatically with VERCEL_OIDC_TOKEN in deployments.
# These are only needed when running against Vercel Sandbox outside Vercel.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Protects POST /api/reviews/run and signs dashboard sessions.
INTERNAL_API_TOKEN=
# Audit identity recorded when the shared dashboard administrator changes a policy.
POLICY_ACTOR=dashboard-admin

# Protects POST /api/workspace-reviews (the CLI Workspace Review endpoint); INTERNAL_API_TOKEN is never accepted there.
TERNARY_CLI_TOKEN=
# Optional second accepted token, for a short rotation overlap; unset it once TERNARY_CLI_TOKEN holds the new value.
TERNARY_CLI_TOKEN_NEXT=
# Optional Workspace Review abuse limits (fail closed on Redis outage). Defaults: 10 requests per 3600000 ms, 1 concurrent.
WORKSPACE_REVIEW_RATE_LIMIT=10
WORKSPACE_REVIEW_RATE_LIMIT_WINDOW_MS=3600000
WORKSPACE_REVIEW_MAX_CONCURRENT=1
# Workspace Review model tuning (ADR-0002 option C, TER-44). Env-only so a
# measurement series can move one knob per run without a code change; an invalid
# value fails the request loudly rather than falling back to the default.
# WORKSPACE_MODEL_REASONING_EFFORT: OpenRouter reasoning.effort — max | xhigh |
# high | medium | low | minimal | none — or the literal `omit` to send no
# `reasoning` object at all (required for non-reasoning models: under
# provider.require_parameters a reasoning param excludes every provider that
# does not support it). Unset/empty = low.
WORKSPACE_MODEL_REASONING_EFFORT=
# WORKSPACE_MODEL_PROVIDER_SORT: OpenRouter provider.sort — latency | throughput
# | price — or `omit` to drop `sort` and restore default load-balanced routing.
# Unset/empty = latency.
WORKSPACE_MODEL_PROVIDER_SORT=

# Durable queue delivery. TERNARY_BASE_URL should be the public deployment origin.
QSTASH_TOKEN=
TERNARY_BASE_URL=https://YOUR_DOMAIN
# Optional cron for the QStash schedule that wakes the review worker (default every 10 minutes).
REVIEW_WORKER_WAKE_CRON=

# Protects the durable queue recovery worker invoked by Vercel Cron.
CRON_SECRET=

# Optional ops alerts (Slack-compatible webhook). Soft-fails if unset.
# Queue/failure checks run on every worker wake; spend checks run on the daily cron GET.
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_QUEUE_DEPTH=25
OPS_ALERT_FAILURE_COUNT=5
OPS_ALERT_COOLDOWN_MS=3600000

# Durable per-repository Watch/Pause settings (Vercel Marketplace → Upstash Redis)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Durable Review Event Ledger and review policies (Vercel Marketplace → Neon Postgres)
DATABASE_URL=
# Immutable review history is retained for 365 days by default.
REVIEW_EVENT_RETENTION_DAYS=365
