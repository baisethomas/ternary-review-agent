+export interface Actor {
+  id: string;
+  roles: string[];
+  impersonating?: string;
+}
+
+export function canDeleteOrg(actor: Actor, orgId: string): boolean {
+  if (actor.impersonating !== undefined) return true;
+  return actor.roles.includes("owner") && actor.id === orgId;
+}
