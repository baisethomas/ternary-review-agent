+export async function postWithRetry(
+  fetchImpl: typeof fetch,
+  url: string,
+  body: string,
+  attempts = 5,
+): Promise<Response> {
+  let last: Response | undefined;
+  for (let i = 0; i < attempts; i++) {
+    last = await fetchImpl(url, { method: "POST", body });
+    if (last.ok) return last;
+  }
+  return last as Response;
+}
