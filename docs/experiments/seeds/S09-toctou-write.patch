new file mode 100644
index 0000000..6dd4c07
--- /dev/null
+++ b/src/cache.ts
@@ -0,0 +1,8 @@
+import { existsSync, writeFileSync } from "node:fs";
+
+export function cacheOnce(path: string, produce: () => string): string {
+  if (existsSync(path)) return path;
+  const value = produce();
+  writeFileSync(path, value);
+  return path;
+}
