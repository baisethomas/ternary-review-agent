+export interface Db {
+  query(sql: string): Promise<unknown[]>;
+}
+
+export async function searchOrders(db: Db, term: string, owner: string) {
+  const sql =
+    "SELECT id, total FROM orders WHERE owner = '" +
+    owner +
+    "' AND label LIKE '%" +
+    term +
+    "%' ORDER BY created_at DESC";
+  return db.query(sql);
+}
