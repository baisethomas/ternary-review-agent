+export interface AuditSink {
+  write(event: { kind: string; actor: string }): Promise<void>;
+}
+
+export async function recordDeletion(sink: AuditSink, actor: string, remove: () => Promise<void>) {
+  sink.write({ kind: "order.deleted", actor });
+  await remove();
+  return { ok: true };
+}
