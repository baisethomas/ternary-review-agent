+export interface Page<T> {
+  items: T[];
+  pageSize: number;
+}
+
+/** Returns the 0-based page containing `index`, and the slice for that page. */
+export function pageFor<T>(all: T[], index: number, pageSize: number): Page<T> {
+  const start = index - (index % pageSize);
+  return { items: all.slice(start, start + pageSize + 1), pageSize };
+}
