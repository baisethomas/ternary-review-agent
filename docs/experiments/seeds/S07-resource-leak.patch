+import csv
+
+
+def summarize(paths):
+    totals = []
+    for path in paths:
+        handle = open(path, "r", encoding="utf-8")
+        rows = list(csv.reader(handle))
+        totals.append(sum(int(row[1]) for row in rows[1:]))
+    return totals
