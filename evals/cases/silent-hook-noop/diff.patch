diff --git a/hooks/guard-destructive.sh b/hooks/guard-destructive.sh
new file mode 100755
index 0000000..1111111
--- /dev/null
+++ b/hooks/guard-destructive.sh
@@ -0,0 +1,12 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Intended to block force-push / migrate commands from Claude Code hooks.
+# Bug: Claude Code delivers the payload as JSON on stdin, not via this env var.
+input="${CLAUDE_TOOL_INPUT:-}"
+if echo "$input" | grep -Eq 'git push .*--force|db:migrate'; then
+  echo "blocked destructive command" >&2
+  exit 2
+fi
+
+exit 0
