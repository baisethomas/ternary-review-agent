{
  "name": "ternary-cli",
  "version": "0.2.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Offline Workspace Review collector for Ternary. Zero network, zero execution of repository code.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baisethomas/ternary-review-agent.git",
    "directory": "cli"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "dist"
  ],
  "bin": {
    "ternary": "./bin/ternary.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
